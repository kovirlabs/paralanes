  "commands": [
    "cd diagsteno/experiments/socket_locality && cargo build --release",
    "for r in 1 2 3; do ./target/release/socket-locality memory --secs 8; ./target/release/socket-locality pipeline --secs 15; done"
  ],
  "method": {
    "memory": "Threads pinned with stagelanes-arch to one node's physical cores, each reading its own 512 MiB stagelanes-mem Region bound to node 0 or 1 (mbind before touch). read_gb_s: sequential u64 reads over 8 s. chase_ns_per_load: 1 thread, a random cycle through every 64-byte line of a 512 MiB region, 20M dependent loads after 2M warm-up",
    "pipeline": "One producer thread copies 4096-sample accelerometer windows (memory local to the producer) round-robin into 10 bounded queues; 10 worker threads run diagsteno::features::reference (Q31 FFT, band energies, time stats). Windows per second over 15 s after 1 s warm-up. Queues stayed full (mean queue wait ~0.6 ms), so the workers are the bottleneck"
  },
